# Growth Horizon - Configuracion de entorno
# Copia este archivo como .env y ajusta los valores

# Clave secreta para Flask (cambiar en produccion)
SECRET_KEY=cambiar-esta-clave-secreta-en-produccion

# Conexion a MySQL via PyMySQL
# Formato: mysql+pymysql://USUARIO:PASSWORD@HOST:PUERTO/BD?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:password@localhost/growthhorizon?charset=utf8mb4
